<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_type_list" model="ir.ui.view">
        <field name="name">activity.type.list</field>
        <field name="model">activity.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_activity_type_form" model="ir.ui.view">
        <field name="name">activity.type.form</field>
        <field name="model">activity.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_activity_type" model="ir.actions.act_window">
        <field name="name">Activity Type</field>
        <field name="res_model">activity.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_activity_type" name="Activity Type" parent="contacts.res_partner_menu_config" action="action_activity_type" sequence="12"/>
</odoo>
