<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_discharge_reason_list" model="ir.ui.view">
        <field name="name">discharge.reason.list</field>
        <field name="model">discharge.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_discharge_reason_form" model="ir.ui.view">
        <field name="name">discharge.reason.form</field>
        <field name="model">discharge.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_discharge_reason" model="ir.actions.act_window">
        <field name="name">Discharge Reasons</field>
        <field name="res_model">discharge.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_discharge_reason"
        name="Discharge Reason"
        parent="contacts.res_partner_menu_config"
        action="action_discharge_reason"
        sequence="10"/>
</odoo>
