<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_group_list" model="ir.ui.view">
        <field name="name">company.group.list</field>
        <field name="model">company.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="group_number"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_company_group_form" model="ir.ui.view">
        <field name="name">company.group.form</field>
        <field name="model">company.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="group_number"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_group" model="ir.actions.act_window">
        <field name="name">Company Groups</field>
        <field name="res_model">company.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_company_group"
        name="Company Group"
        parent="contacts.res_partner_menu_config"
        action="action_company_group"
        sequence="11"/>
</odoo>
