<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="sale_order_portal_inherit_FNT_sale_purchase_followup"
        name="sale.order.portal.inherit.FNT.sale.purchase.followup"
        inherit_id="sale.sale_order_portal_template"
        priority="20">
        <xpath expr="//a[@id='print_invoice_report']/.." position="after">
            <div class="mt-2">
                <t t-if="sale_order.is_po_overdue">
                    <span class="badge bg-warning w-100 text-center d-block py-2">PO Overdue</span>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
