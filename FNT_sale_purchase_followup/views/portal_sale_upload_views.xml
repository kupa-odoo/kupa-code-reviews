<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sale_upload_form" name="Portal Sale Upload Form">
        <t t-call="website.layout">
            <div class="container mt-4 mb-4 o_portal_sale_upload">
                <div class="card shadow-sm" style="max-width:650px;margin:auto;">
                    <div
                        class="bg-primary d-flex justify-content-center align-items-center text-white"
                        style="height:60px;">
                        <h3>Upload PO File for Your Sale Order</h3>
                    </div>
                    <form class="p-4" action="/sale/upload/submit" method="post" enctype="multipart/form-data">
                        <div class="form-group mb-3">
                            <label class="fw-bold">Select Sale Order</label>
                            <select class="form-control" name="sale_order_id" required="required">
                                <option value="">-- Choose Sale Order --</option>
                                <t t-foreach="sale_orders" t-as="so">
                                    <option t-att-value="so.id">
                                        <t t-esc="so.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input
                                    type="checkbox"
                                    name="is_manually_sent"
                                    class="form-check-input o_toggle_manual"
                                    id="toggle_manual"/>
                                <label class="form-check-label" for="toggle_manual">
                                    Fill Sent Manually Date
                                </label>
                            </div>
                        </div>
                        <div class="form-group mb-3 o_file_wrapper">
                            <label class="fw-bold">Upload File</label>
                            <input type="file" name="upload_file" class="form-control o_upload_file"/>
                        </div>
                        <div class="form-group mb-3 o_manual_date_wrapper" style="display: none;">
                            <label class="fw-bold">Sent Manually On:</label>
                            <input
                                type="text"
                                data-widget="datetime-picker"
                                data-widget-type="date"
                                name="manual_date"
                                class="datetimepicker-input form-control o_manual_date"
                                placeholder="MM/DD/YYYY"
                                autocomplete="off"/>
                        </div>
                         <div class="form-group d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-download"/> Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_sale_upload_success" name="Portal Upload Success">
        <t t-call="website.layout">
            <div class="container mt-5 text-center">
                <t t-if="manual_date">
                    <div class="alert alert-success p-4" style="max-width:650px;margin:auto;">
                        <h3>Details Submitted Successfully!</h3>
                        <p>The sale order <strong
                                t-esc="sale_order_name"/> has been marked as <b>sent manually</b> on <strong
                                t-esc="manual_date"/>.</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-success p-4" style="max-width:650px;margin:auto;">
                        <h3>File Uploaded Successfully!</h3>
                        <p>Your file has been attached to Sale Order: <strong t-esc="sale_order_name"/></p>
                    </div>
                </t>
                <a href="/sale/upload" class="btn btn-secondary mt-3">Upload Another</a>
            </div>
        </t>
    </template>
</odoo>
