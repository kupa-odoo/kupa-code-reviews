<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sale_followup" model="ir.cron">
        <field name="name">Sale Order Followup Cron</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_followup_sales_orders()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
    </record>
</odoo>
