<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="allocate_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">allocate.payment.wizard.view.form</field>
        <field name="model">allocate.payment</field>
        <field name="arch" type="xml">
            <form string="Allocate Payment">
                <group>
                    <field name="partner_name" />
                    <field name="payment_amount"/>
                    <field name="avaliable_amount"/>
                </group>
                <group>
                    <field name="invoice_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="move_id"/>
                            <field name="total_amount"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Allocate" type="object" name="allocate_payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
