<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="edit_project_inhetit_birtum_project_client_time" model="ir.ui.view">
        <field name="name">edit.project.inhetit.birtum.project.client.time</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="priority">24</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_time_managment']" position="inside">
                <setting class="col-lg-12" id="timesheet_settings" string="percentage for hours charge">
                    <field name="client_percentage" widget="percentage"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
