<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quant_search_view_inherit_iton_arms_code" model="ir.ui.view">
        <field name="name">stock.quant.search.inherit.iton.arms.code</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='product_id']" position="after">
                <field name="arms_code" />
            </xpath>
        </field>
    </record>
</odoo>
