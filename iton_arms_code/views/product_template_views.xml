<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_iton_arms_code" model="ir.ui.view">
        <field name="name">product.template.view.form.iton.arms.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="arms_code" invisible="product_variant_count &gt; 1
                    or (product_variant_count == 0
                    and valid_product_template_attribute_line_ids)
                    or type in ['service', 'combo']"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_iton_arms_code" model="ir.ui.view">
        <field name="name">product.template.search.view.itom.arms.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='product_tag_ids']" position="after">
                <field name="arms_code" string="Arms Code" />
            </xpath>
        </field>
    </record>

    <record id="view_template_property_form_iton_arms_code" model="ir.ui.view">
        <field name="name">product.template.stock.property.form.inherit.iton.arms.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='weight']" position="after">
                <label for="length" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <div class="o_row" name="length" invisible="product_variant_count &gt; 1 and not is_product_variant">
                    <field name="length" class="oe_inline"/>
                    <field name="lhw_uom_name"/>
                </div>
                <label for="width" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <div class="o_row" name="width" invisible="product_variant_count &gt; 1 and not is_product_variant">
                    <field name="width" class="oe_inline"/>
                    <field name="lhw_uom_name"/>
                </div>
                <label for="height" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <div class="o_row" name="height" invisible="product_variant_count &gt; 1 and not is_product_variant">
                    <field name="height" class="oe_inline"/>
                    <field name="lhw_uom_name"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
