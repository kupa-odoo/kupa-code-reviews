<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_scrap_search_view_iton_arms_code" model="ir.ui.view">
        <field name="name">stock.scrap.search.view.iton.arms.code</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='product_id']" position="after">
                <field name="arms_code" />
            </xpath>
        </field>
    </record>
</odoo>
