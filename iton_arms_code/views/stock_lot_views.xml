<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="search_product_lot_filter_iton_arms_code" model="ir.ui.view">
        <field name="name">search.product.lot.filter.iton.arms.code</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='product_id']" position="after">
                <field name="arms_code" />
            </xpath>
        </field>
    </record>
</odoo>
