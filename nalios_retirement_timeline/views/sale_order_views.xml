<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_nalios_retirement_timeline" model="ir.ui.view">
        <field name="name">view.order.form.inherit.nalios.retirement.timeline</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_draft']" position="after">
                <button
                    name="action_project_approved"
                    invisible="state == 'sale' or project_approved_done"
                    type="object"
                    string="Project Approved"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>
</odoo>
