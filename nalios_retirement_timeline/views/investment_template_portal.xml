<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_inherit_investment" name="nalios_retirement_timeline.portal_my_home" inherit_id="portal.portal_my_home">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <t t-if="next_investment">
                <div t-attf-class="o_portal_index_card col-md-6 order-2">
                    <a title="Next Investment" t-attf-class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="alert-link lh-lg">
                            <div t-attf-class="mt-0 mb-1 fs-5 fw-normal fw-bold">
                                 Project Name : <t t-esc="next_investment.project_id.name"/>
                            </div>
                            <div class="opacity-75 lh-1">
                                <p>
                                    Investment Date : <t t-esc="next_investment.date"/>
                                </p>
                                <p>
                                    Investment Label : <t t-esc="next_investment.label"/>
                                </p>
                                <p>
                                    Investment Amount :
                                    <strong>
                                        <t t-esc="next_investment.currency_id.symbol"/>
                                        <t t-esc="next_investment.investment"/>
                                    </strong>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
