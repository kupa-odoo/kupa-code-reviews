<odoo>
    <record id="action_analytic_cost_group" model="ir.actions.act_window">
        <field name="name">Cost Groups</field>
        <field name="res_model">analytic.cost.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_analytic_cost_group_list" model="ir.ui.view">
        <field name="name">analytic.cost.group.list</field>
        <field name="model">analytic.cost.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name_de"/>
                <field name="name_en"/>
            </list>
        </field>
    </record>

    <record id="view_analytic_cost_group_form" model="ir.ui.view">
        <field name="name">analytic.cost.group.form</field>
        <field name="model">analytic.cost.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name_de"/>
                        <field name="name_en"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_analytic_cost_group"
        name="Cost Groups"
        parent="account.menu_analytic_accounting"
        action="action_analytic_cost_group"
        sequence="31"/>
</odoo>
