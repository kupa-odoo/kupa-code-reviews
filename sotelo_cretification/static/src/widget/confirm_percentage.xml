<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sotelo_cretification.ConfirmPercentageField">
        <t t-if="props.readonly">
            <span t-esc="formattedValue"/>
        </t>
        <t t-else="">
            <div class="d-flex">
                <input
                    t-ref="numpadDecimal"
                    t-attf-class="o_input"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    t-on-change="onChange"
                />
                <span>%</span>
            </div>
        </t>
    </t>
</templates>
