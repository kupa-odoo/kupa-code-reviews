<odoo>
    <record id="view_res_config_settings_certification" model="ir.ui.view">
        <field name="name">res.config.settings.certification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']/.." position="after">
                <div id="certfication_settings">
                    <block title="Certification" name="certification_setting_container">
                        <setting id="sms" string="Send Email" help="Send Email to your contacts when Billing Type is changed ">
                            <field name="certification_user_ids" widget="many2many_tags" />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
