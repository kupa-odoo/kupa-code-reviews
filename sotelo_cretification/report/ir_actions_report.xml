<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_project_certification" model="report.paperformat">
        <field name="name">Project Certification</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">270</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52.00</field>
        <field name="margin_bottom">32.00</field>
        <field name="margin_left">10.00</field>
        <field name="margin_right">10.00</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_project_certification" model="ir.actions.report">
        <field name="name">Project Certification</field>
        <field name="model">project.certification</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sotelo_cretification.report_project_certification_document</field>
        <field name="report_file">sotelo_cretification.report_project_certification_document</field>
        <field name="binding_model_id" ref="model_project_certification"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_project_certification"/>
    </record>
</odoo>
