<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contact_address_view_form_inhetir_nalios_contact_invoice" model="ir.ui.view">
        <field name="name">contact.address.view.form.inhetir.nalios.contact.invoice</field>
        <field name="model">contact.address</field>
        <field name="inherit_id" ref="dousseramonage_custos.contact_address_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_to_the_address']" position="after">
                <field name="owner_reference" />
            </xpath>
        </field>
    </record>

    <record id="contact_address_view_tree_inhetir_nalios_contact_invoice" model="ir.ui.view">
        <field name="name">contact.address.view.tree.inhetir.nalios.contact.invoice</field>
        <field name="model">contact.address</field>
        <field name="inherit_id" ref="dousseramonage_custos.contact_address_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id']" position="before">
                <field name="owner_reference" optional="show" />
            </xpath>

            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='street2']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='label_ids']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
