<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_bfc_partner_account_sync" model="ir.ui.view">
        <field name="name">view.partner.form.inherit.bfc.partner.account.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]/.." position="before">
                <header>
                    <button
                        name="action_sync_partner_accounts_from_master"
                        type="object"
                        class="btn-primary"
                        string="Sync Partner Account"
                        invisible="not is_master_company_active"
                        groups="account.group_account_readonly" />
                </header>
            </xpath>
        </field>
    </record>

     <record id="view_partner_property_form_inherit_bfc_partner_account_sync" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.bfc.partner.account.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="is_master_company_active" invisible="1" />    <!--Technical Field -->
            </xpath>
        </field>
    </record>
</odoo>
