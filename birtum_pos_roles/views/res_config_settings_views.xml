<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_birtum_pos_roles" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.birtum.pos.roles</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_advanced_employee_ids']/.." position="after">
                <div class="row">
                    <label for="pos_sales_assistant_ids" string="Sales Assistant" class="col-lg-5 o_light_label" />
                    <field name="pos_sales_assistant_ids" widget="many2many_tags" placeholder="All Employees" domain="[('company_id', '=', company_id)]" />
                </div>
            </xpath>

            <xpath expr="//field[@name='pos_basic_employee_ids']/.." position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='pos_minimal_employee_ids']/.." position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
