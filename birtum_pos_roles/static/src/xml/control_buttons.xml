<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="birtum_pos_roles.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[i[@title='Refund']]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant' and !(this.pos.cashier._role === 'manager' and !this.pos.cashier._is_pos_manager)</attribute>
        </xpath>

        <xpath expr="//button[i[@title='Price list']]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant'</attribute>
        </xpath>

        <xpath expr="//button[hasclass('js_discount')]" position="attributes">
            <attribute name="t-if">this.pos.config.module_pos_discount and this.pos.config.discount_product_id and this.pos.cashier._role !== 'sale_assistant'</attribute>
        </xpath>

        <xpath expr="//button[hasclass('o_fiscal_position_button')]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant'</attribute>
        </xpath>
    </t>

    <t t-name="birtum_pos_roles.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant' and !(this.pos.cashier._role === 'manager' and !this.pos.cashier._is_pos_manager)</attribute>
        </xpath>
    </t>

    <t t-name="birtum_pos_roles.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant' and !(this.pos.cashier._role === 'manager' and !this.pos.cashier._is_pos_manager)</attribute>
        </xpath>
    </t>

    <t t-name="birtum_pos_roles.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-method-display')]/.." position="attributes">
            <attribute name="t-if">
                !(this.pos.cashier._role === 'sale_assistant' and paymentMethod.type === 'pay_later')  and
                !(
                    paymentMethod.type === 'pay_later' and
                    this.pos.cashier._role === 'manager' and
                    !this.pos.cashier._is_pos_manager
                )
            </attribute>
        </xpath>
    </t>

     <t t-name="pos_hr.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(text(), 'Create Product')]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role !== 'sale_assistant'</attribute>
        </xpath>
    </t>
</templates>
