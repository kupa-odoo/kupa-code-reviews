<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_partner_type" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.partner.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_type_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_type_list" model="ir.ui.view">
        <field name="name">partner.type.list</field>
        <field name="model">partner.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_partner_type_form" model="ir.ui.view">
        <field name="name">partner.type.form</field>
        <field name="model">partner.type</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_partner_type" model="ir.actions.act_window">
        <field name="name">Partner Types</field>
        <field name="res_model">partner.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_partner_type_root"
            name="Type de client"
            parent="contacts.menu_contacts"
            action="action_partner_type"
            sequence="15"/>
</odoo>
