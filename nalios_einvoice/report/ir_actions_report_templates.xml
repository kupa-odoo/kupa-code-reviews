<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='section_name_colspan']" position="attributes">
            <attribute name="t-value">0 + (1 if display_discount else 0) + (1 if display_taxes else 0)</attribute>
        </xpath>

        <xpath expr="//td[@name='td_section_price'][span[@name='price_subtotal_section']]" position="before">
            <td t-if="show_section_total" name="td_section_price" class="text-end o_price_total">
                <t t-set="section_qty" t-value="line._get_section_quantities()[0]"/>
                <t t-set="section_uom" t-value="line._get_section_quantities()[1]"/>
                <span t-if="section_uom">
                    <t t-esc="'%.2f' % section_qty"/> <t t-esc="section_uom.name"/>&#160;
                </span>
            </td>
            <td t-if="show_section_total" t-att-colspan="2"></td>
        </xpath>
    </template>
</odoo>
